# Copy to .env for local development, and set the same keys in the Vercel
# project's Environment Variables. lib/auth/index.ts is evaluated during the
# build, so MONGODB_URI must exist in the build environment too, not only at
# runtime.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/job-board-dev

# Better Auth: random 32+ character string, unique per environment
BETTER_AUTH_SECRET=

# Base URL of the deployment. http://localhost:3000 locally, the full
# https:// production domain on Vercel.
BETTER_AUTH_URL=http://localhost:3000

# Optional. Which user `pnpm seed` populates. Defaults to the id in scripts/seed.ts
SEED_USER_ID=
